{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@waha/shared": ["libs/shared/src/index"],
      "@waha/shared/*": ["libs/shared/src/*"],
      "@waha/*": ["src/*"]
    },
    "incremental": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}