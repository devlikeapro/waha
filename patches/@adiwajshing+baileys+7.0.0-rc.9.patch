+export function batched(fn, size, post) {
+    return async (...args) => {
+        const [jids, ...rest] = args;
+        const results = [];
+        for (let i = 0; i < jids.length; i += size) {
+            const batch = jids.slice(i, i + size);
+            const result = await fn(batch, ...rest);
+            results.push(result);
+        }
+        if (post) {
+            return post(results);
+        }
+        return results;
+    };
+}
+//# sourceMappingURL=batched.js.map
