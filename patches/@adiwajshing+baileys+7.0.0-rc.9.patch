+export class USyncBotProfileProtocol {
+    constructor() {
+        this.name = 'bot';
+    }
+    getQueryElement() {
+        return {
+            tag: 'bot',
+            attrs: {},
+            content: [{ tag: 'profile', attrs: { v: '1' } }]
+        };
